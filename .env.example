# Copy to .env for docker compose -f docker-compose.prod.yml up --build.
# Use a generated URL-safe password. This example value is for local evaluation only.
POSTGRES_DB=geoopportunity
POSTGRES_USER=geoopportunity
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_OSM_RASTER_BASEMAP=false
DEFAULT_LOCALE=id
